config wifi-device 'radio0'
	option type 'mac80211'
	option channel 'auto'
	option band '2g'
	option htmode 'HE40'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid '康达姆机器人_2.4G'
	option encryption 'psk2+ccmp'
	option key '123*567890'

config wifi-device 'radio1'
	option type 'mac80211'
	option channel 'auto'
	option band '5g'
	option htmode 'HE80'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid '康达姆机器人_5G'
	option encryption 'psk2+ccmp'
	option key '123*567890'
