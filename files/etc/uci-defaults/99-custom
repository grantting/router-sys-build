#!/bin/bash

# 追加编译作者信息 
modify_firmware_description() {
    sed -i "s/\(DISTRIB_DESCRIPTION='.*\)'/\1 Compiled by xding'/" /etc/openwrt_release 
}

# 设置root密码 
set_root_password() {
    echo -e "root\nroot" | passwd root >/dev/null 2>&1 
}

# 配置WAN口LED 
configure_led_wan() {
    uci del system.led_wan.dev  2>/dev/null 
    uci del system.led_wan.mode  2>/dev/null 
    uci set system.led_wan.trigger='default-on' 
    uci commit system 
}

# 配置定时重启 
configure_taskplan() {
    uci delete taskplan.weekly_reboot  2>/dev/null
    
    uci add taskplan stime 
    uci rename taskplan.@stime[-1]='weekly_reboot'
    uci set taskplan.weekly_reboot.enable='1' 
    uci set taskplan.weekly_reboot.stype='1'
    uci set taskplan.weekly_reboot.month='*'
    uci set taskplan.weekly_reboot.week='0'
    uci set taskplan.weekly_reboot.hour='5'
    uci set taskplan.weekly_reboot.minute='0'
    uci set taskplan.weekly_reboot.command='reboot'
    uci set taskplan.weekly_reboot.remarks='每周日凌晨5点自动重启系统'
    
    uci commit taskplan
    /etc/init.d/taskplan restart 2>/dev/null
}

# 配置KMS服务器 
configure_vlmcsd() {
    uci set vlmcsd.config.enabled='1' 
    uci set vlmcsd.config.auto_activate='1' 
    uci set vlmcsd.config.internet_access='1' 
    uci commit vlmcsd 
    /etc/init.d/vlmcsd restart 2>/dev/null 
}

# 配置Passwall 
configure_passwall() {
    uci add passwall nodes
    usleep 100000
    uci set passwall.@nodes[-1].remarks='自动切换'
    uci set passwall.@nodes[-1].type='Socks'
    uci set passwall.@nodes[-1].address='127.0.0.1'
    uci set passwall.@nodes[-1].port='1081'
    uci commit passwall
}

# 主执行流程 
main() {
    modify_firmware_description 
    set_root_password 
    configure_led_wan 
    configure_taskplan 
    configure_vlmcsd
    configure_passwall
}

main

rm -f /etc/uci-defaults/99-custom 2>/dev/null 
